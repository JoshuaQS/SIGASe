APP_NAME=SIGASe
APP_ENV=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sigase
DB_USER=root
DB_PASSWORD=change_me

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sigase?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

APP_JWT_SECRET=replace_with_long_random_secret
APP_JWT_ISSUER=sigase
APP_JWT_ADMIN_EXP_SECONDS=1800
APP_JWT_STUDENT_EXP_SECONDS=900

APP_AUTH_LOCKOUT_MAX_FAILED_ATTEMPTS=5
APP_AUTH_LOCKOUT_DURATION_MINUTES=15

APP_AES_SECRET=replace_with_32_characters_exactly

APP_GOOGLE_CLIENT_ID=replace_with_google_client_id
APP_GOOGLE_ALLOWED_DOMAIN=utez.edu.mx

APP_ELIBRO_ALLOWED_HOSTS=elibro.net,www.elibro.net

SERVER_PORT=8080

APP_LOG_SANITIZE_HASH_IP=false
APP_LOG_SANITIZE_MASK_IP=true
APP_LOG_SANITIZE_USER_AGENT_MAX_LENGTH=160
APP_LOG_SANITIZE_URL_MAX_LENGTH=400
APP_LOG_SANITIZE_METADATA_MAX_LENGTH=4000
APP_LOG_SANITIZE_EMAIL_VISIBLE_PREFIX=2

APP_SEED_ADMIN_EMAIL=
APP_SEED_ADMIN_PASSWORD=
APP_SEED_ADMIN_FULL_NAME=Administrador TI

APP_SEED_ADMIN_BIBLIOTECA_EMAIL=
APP_SEED_ADMIN_BIBLIOTECA_PASSWORD=
APP_SEED_ADMIN_BIBLIOTECA_FULL_NAME=Administrador Biblioteca

APP_FRONTEND_BASE_URL=http://localhost:5173

# SMTP local para desarrollo (MailHog)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=
SPRING_MAIL_STARTTLS_ENABLE=
SPRING_MAIL_STARTTLS_REQUIRED=
