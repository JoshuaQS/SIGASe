# Copia a .env en la raíz del módulo server (mismo directorio que pom.xml)
# y rellena los valores. Spring carga optional:file:.env vía application.properties.

# --- Obligatorias (sin valor por defecto en application.properties) ---

APP_NAME=sigase-server

# Crea la base antes del primer arranque si MySQL dice "Unknown database 'sigase'":
#   mysql -u root -p < scripts/create-database.sql
# Si la BD está vacía, Hibernate con validate fallará hasta tener tablas.
# En local, application-dev.properties fuerza ddl-auto=update (perfil dev por defecto).
# Solo descomenta esto en prod/CI con esquema ya migrado:
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sigase?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=cambiar

APP_JWT_SECRET=cambiar-por-secreto-largo-y-aleatorio-min-256-bits
APP_JWT_ADMIN_EXP_SECONDS=3600
APP_JWT_STUDENT_EXP_SECONDS=86400

APP_AES_SECRET=cambiar-clave-para-elibro
APP_ELIBRO_ALLOWED_HOSTS=localhost,127.0.0.1

APP_GOOGLE_ALLOWED_DOMAIN=tudominio.edu.mx
APP_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

SPRING_MAIL_HOST=smtp.ejemplo.com
SPRING_MAIL_USERNAME=no-reply@ejemplo.com
SPRING_MAIL_PASSWORD=cambiar

# --- Opcionales (tienen default en application.properties si las omites) ---

# SERVER_PORT=8080
# APP_JWT_ISSUER=sigase
# APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:18080
# APP_FRONTEND_BASE_URL=http://localhost:5173
# APP_ELIBRO_BASE_URL=https://auth.elibro.net/auth/sso/
# SPRING_MAIL_PORT=587
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_STARTTLS_ENABLE=true
# SPRING_MAIL_STARTTLS_REQUIRED=true
# APP_MAIL_FROM=no-reply@ejemplo.com

# Semilla de admin (vacío = no crear por env)
# APP_SEED_ADMIN_EMAIL=
# APP_SEED_ADMIN_PASSWORD=
# APP_SEED_ADMIN_FULL_NAME=Administrador TI
# APP_SEED_ADMIN_BIBLIOTECA_EMAIL=
# APP_SEED_ADMIN_BIBLIOTECA_PASSWORD=
# APP_SEED_ADMIN_BIBLIOTECA_FULL_NAME=Administrador Biblioteca
# APP_SEED_DASHBOARD_DEMO_ENABLED=false

# Logs / seguridad
# APP_AUTH_LOCKOUT_MAX_FAILED_ATTEMPTS=5
# APP_AUTH_LOCKOUT_DURATION_MINUTES=15
# APP_LOG_SANITIZE_HASH_IP=false
# APP_LOG_SANITIZE_MASK_IP=true
# APP_LOG_LEVEL_SPRING_SECURITY=INFO
# APP_LOG_LEVEL_APP=INFO
