# Docker Compose variables for SIGASe runtime.
# Keep application secrets in server/.env, not here.

COMPOSE_PROJECT_NAME=sigase

FRONTEND_PORT=18080
BACKEND_PORT=8080

MYSQL_DATABASE=sigase
MYSQL_USER=sigase
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

VITE_API_URL=/api/v1
SPRING_PROFILES_ACTIVE=prod
APP_ALLOWED_ORIGINS=http://localhost:18080,http://localhost:5173
APP_FRONTEND_BASE_URL=http://localhost:18080
