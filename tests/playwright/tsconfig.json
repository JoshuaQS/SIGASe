{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "types": [
            "node",
            "@playwright/test"
        ],
        "baseUrl": ".",
        "paths": {
            "@pages/*": [
                "pages/*"
            ],
            "@helpers/*": [
                "helpers/*"
            ],
            "@fixtures/*": [
                "fixtures/*"
            ]
        },
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    }
}